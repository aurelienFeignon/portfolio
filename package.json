{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bundle": "node scripts/check-bundle-budget.mts && node scripts/check-scene-isolation.mts",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "check-content": "node scripts/check-content.mts",
    "check-static": "node scripts/check-static-rendering.mts",
    "build": "node scripts/check-content.mts && node scripts/generate-route-manifest.mts && node scripts/generate-board-plan.mts && next build && node scripts/check-static-rendering.mts",
    "start": "next start -H 0.0.0.0 -p 3000",
    "check-dns": "node scripts/check-dns.mts",
    "lighthouse": "node scripts/check-lighthouse.mts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "jsdom": "30.1.3",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
