root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Make exige des tabulations en tête de recette : une conversion en espaces
# rend le Makefile inutilisable.
[Makefile]
indent_style = tab

[*.md]
# Deux espaces en fin de ligne = saut de ligne en Markdown.
trim_trailing_whitespace = false
